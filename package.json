    "lucide-react": "^1.23.0",
    "next": "^16.3.4",
    "openai": "^7.15.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "twilio": "^6.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
